            "replicas": 1,
            "capacity_rps": 50000,
            "base_latency_ms": 3,
            "cache_hit_rate": 0.92,
            "cache_warmup_ticks": 4,
            "cache_invalidation_rate": 0.08
          }
        },
        {
          "id": "db-1",
          "label": "DB",
          "archetype": "database",
          "color": "coral",
          "position": { "x": 520, "y": 0 },
          "properties": {
            "replicas": 3,
            "capacity_rps": 4500,
            "base_latency_ms": 24,
            "read_capacity_rps": 6500,
