            "replicas": 2,
            "capacity_rps": 12000,
            "base_latency_ms": 18
          }
        },
        {
          "id": "cache-1",
          "label": "Cache",
          "archetype": "cache",
          "color": "amber",
          "position": { "x": 320, "y": -80 },
